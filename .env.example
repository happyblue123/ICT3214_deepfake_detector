# Optional settings. Defaults work without a .env file.
# Each teammate runs their own local instance.
VOICE_SCOPE_PORT=8000
# Completed media and text checks stay until deleted. Set a positive number for timed expiry.
HISTORY_RETENTION_MINUTES=0
DETECTOR_PLUGIN=
CONTENT_PLUGIN=
MODEL_DIR=models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Example after Member 1 supplies the adapter:
# DETECTOR_PLUGIN=plugins.your_detector:create_detector
# CONTENT_PLUGIN=plugins.your_content:create_analyzer
